{
  "name": "sam-sebe-rpg-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:contract": "node --test --experimental-strip-types tests/api-contract.test.ts tests/living-npc-contract.test.ts tests/playtest-contract.test.ts tests/production-art.test.ts tests/production-assets-materialized.test.ts tests/prototype-art.test.ts tests/stream-mode-contract.test.ts",
    "preview": "vite preview",
    "test:e2e": "node scripts/reset-e2e.mjs && playwright test",
    "test:e2e:canonical": "node scripts/reset-e2e.mjs && playwright test tests/vertical-slice.spec.ts",
    "test:e2e:exploratory": "node scripts/reset-e2e.mjs && playwright test tests/exploratory.spec.ts",
    "test:e2e:living-npc": "node scripts/reset-living-npc-e2e.mjs && playwright test -c playwright.living-npc.config.ts",
    "test:e2e:social-world": "node scripts/reset-social-world-e2e.mjs && playwright test -c playwright.social-world.config.ts",
    "test:e2e:stream-slice": "node scripts/reset-stream-slice-e2e.mjs && playwright test -c playwright.stream-slice.config.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@playwright/test": "^1.55.0"
  }
}
